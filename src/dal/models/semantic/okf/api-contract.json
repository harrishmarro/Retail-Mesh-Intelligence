{
  "openapi": "3.1.0",
  "info": {
    "title": "Retail-Mesh authorized knowledge read API",
    "version": "1.0.0"
  },
  "security": [
    {
      "cookieAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "retail_mesh_session"
      }
    }
  },
  "paths": {
    "/api/workspace/knowledge": {
      "get": {
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized company or provider-scoped snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Company access denied"
          }
        }
      }
    },
    "/api/workspace/knowledge-export": {
      "get": {
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized company or provider-scoped snapshot",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Company access denied"
          }
        }
      }
    },
    "/api/workspace/knowledge-ask": {
      "post": {
        "description": "Deterministic read-only question; no external model. CSRF required.",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "company_id",
                  "question"
                ],
                "properties": {
                  "company_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded answer with source citations"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Access or CSRF denied"
          }
        }
      }
    }
  }
}
