PREFIX rm: <https://example.org/retail-mesh/vocab#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?beneficiary ?amountMinor ?currency ?ruleVersion ?snapshot WHERE {
 ?award a rm:ProviderAward;
   rm:beneficiary/rdfs:label ?beneficiary;
   rm:amountMinor ?amountMinor;
   rm:currency ?currency;
   prov:wasGeneratedBy ?evaluation.
 ?evaluation rm:appliedRuleVersion ?ruleVersion; prov:used ?snapshot.
}
